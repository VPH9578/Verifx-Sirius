# ═══════════════════════════════════════════════
#  Telegram Signal Copier — Environment Variables
#  Rename to .env and fill in your credentials
# ═══════════════════════════════════════════════

# Telegram (from https://my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=+your_phone_number

# Signal channel to monitor (username or channel ID)
SIGNAL_CHANNEL=-100xxxxxxxxxx
SIGNAL_TOPIC_ID=0

# MetaTrader 5 Primary Settings
MT5_ACCOUNT=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server
MT5_PATH=C:\Program Files\Broker MT5 Terminal\terminal64.exe

# Gemini AI (for Signal Parsing / Analysis)
GEMINI_API_KEY=your_gemini_api_key

# Telegram Alert Bot (Optional)
ALERT_BOT_TOKEN=your_bot_token
ALERT_CHAT_ID=your_chat_id
